APP_NAME=AgencyPulse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=agencypulse
DB_USERNAME=agencypulse
DB_PASSWORD=secret
DB_SCHEMA=public
DB_SSLMODE=prefer

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Screenshots — use Cloudflare R2 in production (S3-compatible)
SCREENSHOT_DISK=public
SCREENSHOT_RETENTION_DAYS=60
# SCREENSHOT_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

# Organization logos — on Vercel use a public R2 bucket (container disk is ephemeral)
UPLOADS_DISK=public
# UPLOADS_DISK=s3_public
# AWS_PUBLIC_BUCKET=
# AWS_PUBLIC_URL=https://pub-<id>.r2.dev

# Vercel Cron → GET /api/v1/cron/daily with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Platform super admin (superadmin@gmail.com). Required in production (min 12 chars);
# local/testing fall back to 12345678.
SUPER_ADMIN_PASSWORD=

# API-first: leave empty — Bearer token auth only (no SPA cookie/CSRF mode)
SANCTUM_STATEFUL_DOMAINS=

# Mail — log locally; Piisend on Render without a domain (see DEPLOY.md)
# For Gmail SMTP on Render Starter+ use MAIL_MAILER=smtp with EMAIL_USER / EMAIL_PASS
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Gmail SMTP (Render Starter+ only — free tier blocks ports 587/465)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# EMAIL_USER=agencypulse.notifications@gmail.com
# EMAIL_PASS=
# MAIL_FROM_ADDRESS=agencypulse.notifications@gmail.com

# Piisend (recommended without a custom domain) — 3,000 emails/month, 100/day, shared sender
# PIISEND_API_KEY=

# Resend — 3,000 emails/month, 100/day, requires verified domain
# RESEND_KEY=

# Brevo — 300 emails/day (~9,000/month), HTTP API on Render (use xkeysib- key, NOT xsmtpsib-)
# MAIL_MAILER=brevo
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM_ADDRESS=agencypulse.notifications@gmail.com

# MailerSend — avoid @mlsender.net trial sender (2-recipient limit)
# MAILERSEND_API_KEY=
