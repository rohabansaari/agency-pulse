APP_NAME=AgencyPulse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=agencypulse
DB_USERNAME=agencypulse
DB_PASSWORD=secret

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Screenshots — use Cloudflare R2 in production (S3-compatible)
SCREENSHOT_DISK=public
SCREENSHOT_RETENTION_DAYS=60
# SCREENSHOT_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

# API-first: leave empty — Bearer token auth only (no SPA cookie/CSRF mode)
SANCTUM_STATEFUL_DOMAINS=

# Mail — use log locally; Gmail SMTP in production (see DEPLOY.md)
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
