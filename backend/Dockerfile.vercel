# Laravel API image for the Vercel "api" service (see /vercel.json).
# FrankenPHP serves public/ on $PORT; build context is backend/.
FROM dunglas/frankenphp:1-php8.3-alpine

RUN install-php-extensions pdo_pgsql pgsql bcmath gd intl zip exif pcntl opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

ENV COMPOSER_ALLOW_SUPERUSER=1

# Install dependencies first so they cache independently of app code.
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-scripts --no-autoloader --no-progress

COPY . .
RUN composer dump-autoload --no-dev --optimize \
    && php artisan package:discover --ansi \
    && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chmod +x vercel/start.sh

COPY vercel/php.ini /usr/local/etc/php/conf.d/99-agencypulse.ini

# Serverless defaults; Vercel project env vars override these at runtime.
ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    LOG_LEVEL=info \
    DB_CONNECTION=pgsql \
    CACHE_STORE=database \
    QUEUE_CONNECTION=sync \
    SESSION_DRIVER=cookie \
    PORT=8080

# Only /tmp is guaranteed writable: move Laravel storage, bootstrap caches and Caddy state there.
ENV LARAVEL_STORAGE_PATH=/tmp/laravel/storage \
    APP_SERVICES_CACHE=/tmp/laravel/cache/services.php \
    APP_PACKAGES_CACHE=/tmp/laravel/cache/packages.php \
    APP_CONFIG_CACHE=/tmp/laravel/cache/config.php \
    APP_ROUTES_CACHE=/tmp/laravel/cache/routes-v7.php \
    APP_EVENTS_CACHE=/tmp/laravel/cache/events.php \
    XDG_CONFIG_HOME=/tmp/caddy/config \
    XDG_DATA_HOME=/tmp/caddy/data

CMD ["/app/vercel/start.sh"]
