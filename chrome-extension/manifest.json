{
  "manifest_version": 3,
  "name": "AgencyPulse Screenshot Monitor",
  "version": "1.2.0",
  "description": "Optional helper for AgencyPulse tab screenshots. The web app also captures without this extension.",
  "permissions": ["tabs", "activeTab", "storage", "alarms", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://agency-pulse-web.onrender.com/*",
        "https://*.agencypulse.app/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AgencyPulse Screenshots"
  }
}
